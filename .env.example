# Offline mode requires no environment variables.
# DashScope/Qwen aliases are supported directly:
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.5-plus

# Generic aliases are also supported for other OpenAI-compatible providers:
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.example.com/v1
# MODEL_NAME=provider-model-id
